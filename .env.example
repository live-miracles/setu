# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enable only for local previews without cloud services
NEXT_PUBLIC_DEMO_MODE=true

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=

# Anyone signing in with a Google account on this domain is automatically
# registered as a member; BOOTSTRAP_ADMIN_EMAIL becomes the first admin.
ALLOWED_EMAIL_DOMAIN=
BOOTSTRAP_ADMIN_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Setu <notifications@example.org>

# Google Drive service account used to upload and publicly link images
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

CRON_SECRET=

# Optional public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
