# The single hosted Supabase project (used for local development and production).
# Local development works against live data, so use a test account and avoid
# bulk or destructive changes. See docs/getting-started.md.
SETU_SUPABASE_URL=https://your-project-ref.supabase.co
SETU_SUPABASE_PUBLISHABLE_KEY=replace-with-your-anon-or-publishable-key
