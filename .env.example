# Hosted Supabase development project (recommended).
SETU_SUPABASE_URL=https://your-project-ref.supabase.co
SETU_SUPABASE_PUBLISHABLE_KEY=replace-with-your-anon-or-publishable-key

# Project references for Supabase CLI deployments.
SETU_SUPABASE_PROJECT_REF_DEV=your-dev-project-ref
SETU_SUPABASE_PROJECT_REF_PROD=your-production-project-ref
