{
    "compilerOptions": {
        "target": "ES2019",
        "lib": ["ES2019", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
