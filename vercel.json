{
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "web",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'sha256-peOzC3gVT9kLoU1SQq/TxhoUZth9pwF4WBv0gf4eBhU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(self), microphone=(), geolocation=()"
                }
            ]
        }
    ],
    "rewrites": [{ "source": "/(.*)", "destination": "/" }]
}
