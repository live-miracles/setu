{
    "name": "setu",
    "version": "0.2.28",
    "description": "Setu — a Google Apps Script + Google Sheets internal ops app.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node build-tools/dev.mjs",
        "build": "node build-tools/build.mjs",
        "build:backend": "node build-tools/build-backend.mjs",
        "pages": "node build-tools/pages.mjs",
        "typecheck": "tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "push": "npm run typecheck && npm run build && clasp push",
        "deploy": "npm run typecheck && npm run build && clasp push && clasp deploy --deploymentId \"$APPS_SCRIPT_DEPLOYMENT_ID\" --description \"$(date +%Y-%m-%dT%H:%M:%S)\"",
        "logs": "clasp logs --watch",
        "open": "clasp open-script"
    },
    "devDependencies": {
        "@google/clasp": "^3.3.0",
        "@tailwindcss/cli": "^4.0.0",
        "@types/google-apps-script": "^1.0.83",
        "@types/qrcode": "^1.5.6",
        "esbuild": "^0.25.0",
        "prettier": "^3.3.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.2",
        "@ant-design/v5-patch-for-react-19": "^1.0.3",
        "@jsquash/avif": "^2.1.1",
        "@refinedev/antd": "^6.0.3",
        "@refinedev/core": "^5.0.12",
        "@refinedev/react-hook-form": "^5.0.4",
        "antd": "^5.29.3",
        "html5-qrcode": "^2.3.8",
        "qrcode": "^1.5.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.85.0",
        "react-markdown": "^6.0.3",
        "remark-gfm": "^1.0.0"
    }
}
