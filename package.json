{
    "name": "setu",
    "version": "0.1.0",
    "description": "Livestream Operations — a Google Apps Script + Google Sheets internal ops app.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node build-tools/dev.mjs",
        "css": "tailwindcss -i frontend-src/input.css -o frontend-src/output.css",
        "build": "node build-tools/build.mjs",
        "typecheck": "tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p frontend-src/tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "push": "npm run typecheck && npm run build && clasp push",
        "deploy": "npm run typecheck && npm run build && clasp push && clasp deploy --deploymentId \"$CLASP_DEPLOYMENT_ID\" --description \"$(date +%Y-%m-%dT%H:%M:%S)\"",
        "logs": "clasp logs --watch",
        "open": "clasp open"
    },
    "devDependencies": {
        "@google/clasp": "^2.4.2",
        "@types/google-apps-script": "^1.0.83",
        "typescript": "^5.5.4",
        "@tailwindcss/cli": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "daisyui": "^5.0.0",
        "browser-sync": "^3.0.4",
        "concurrently": "^9.0.0",
        "prettier": "^3.3.3"
    }
}
